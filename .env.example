# Data Synthesizer Environment Variables
# Copy this file to .env and fill in your values

# API Keys (at least one required)
# Either GEMINI_API_KEY (single) or GEMINI_API_KEYS (comma-separated) is fine.
# When multiple are provided the worker rotates on per-minute rate limits and
# only pauses (until Pacific midnight) when *all* keys have hit their daily
# quota — enabling unstoppable cron-style runs.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=key1,key2,key3
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OpenRouter also supports multi-key rotation (per-minute 429s rotate; if all
# keys throttled at once we honor the server's Retry-After up to 30 min).
OPENROUTER_API_KEYS=key1,key2,key3
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace (required for HF output)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Optional - Notifications
SLACK_WEBHOOK_URL=
NOTIFICATION_EMAIL=

# Public deployment via shared caddy-router (optional)
# Leave blank to keep the service loopback-only.
SYNTH_DOMAIN=synth.casava.space
SYNTH_BASIC_USER=admin
# Generate with:  docker exec caddy-router caddy hash-password --plaintext '<your-password>'
# The hash starts with $2a$... — quote it or escape $ when pasting.
SYNTH_BASIC_HASH=
